{
  "name": "veridian-angular",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "generate:api:auth": "openapi-generator-cli generate -i http://localhost:3000/v3/api-docs/swagger.json -g typescript-angular -o src/app/core/api/auth --additional-properties=ngVersion=21.0.0,providedInRoot=true,fileNaming=kebab-case",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "test": "node tests/accounts.test.mjs && node tests/dashboard.test.mjs && node tests/chatbert.test.mjs && node tests/analytics.test.mjs && node tests/portfolio-chart.test.mjs",
    "test:analytics": "node tests/analytics.test.mjs",
    "check:analytics": "node scripts/check-analytics.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "typescript": "~5.9.3"
  }
}

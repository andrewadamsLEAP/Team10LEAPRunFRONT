{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "veridian-angular": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": ".",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/veridian",
            "index": "index.html",
            "browser": "main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["styles.css"]
          },
          "configurations": {
            "development": {},
            "production": {}
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "veridian-angular:build:production"
            },
            "development": {
              "buildTarget": "veridian-angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
